# Copy to .env and change the secrets. Never commit .env.
# PostgreSQL is recommended for deployment. For a quick local run without Docker,
# use: sqlite:///./eve.db
DATABASE_URL=postgresql+psycopg://eve:eve@localhost:5432/eve
JWT_SECRET=change-me-in-production-min-32-chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=60
WEBHOOK_SECRET=change-me-webhook-secret
# Probability that a simulated payment succeeds when the caller does not force an outcome
PAYMENT_SUCCESS_RATE=0.8
LOG_LEVEL=INFO
# Used only by `python -m app.seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
